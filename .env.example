# --- Required in production ---
NODE_ENV=production
# Managed Postgres (Supabase / Neon / RDS / Cloud SQL ...). Leave empty to use embedded storage in DATA_DIR (single instance, demo only).
DATABASE_URL=
# Optional: keep NextVision tables in their own Postgres schema (created if missing; search_path is set on every connection). Empty = default schema.
DB_SCHEMA=

# --- First admin (optional; otherwise the first visitor sees the setup screen). Set as HOST SECRETS, never commit. ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Storage: clips (converted previews) and keyframes live under DATA_DIR. Mount a persistent disk here in production. ---
DATA_DIR=/data

# --- Limits (defaults shown) ---
MAX_UPLOAD_MB=300
MAX_CLIP_SECONDS=600
PREVIEW_CODEC=h264          # h264 (works everywhere) or vp9
PORT=8080
SESSION_HOURS=12
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
PASSWORD_MIN_LENGTH=10
COOKIE_SECURE=true
TRUST_PROXY=true
